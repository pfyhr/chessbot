/target
**/*.rs.bk
*.pdb

# Build artifacts. maturin's editable install drops the compiled extension into
# the source tree, where it is easy to commit by accident.
*.so
*.dylib
*.pyd

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Training artifacts
# Checkpoints are regenerable and run to hundreds of GB. The experimental record
# is not: every run's history.json holds its loss trajectory, Elo curve, timings
# and truncation rates -- 3.3 MB across 28 runs, and until now the only copy was
# on one laptop. Keep those, drop the rest.
#
# A directory excluded with a trailing slash cannot have anything re-included
# from it, so this has to exclude the contents in two stages instead.
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/history.json
data/
*.safetensors
*.onnx
*.npz

# Benchmark output is regenerated, but keep committed results under bench/results/
bench/scratch/

# Third-party papers are linked in papers/README.md, not redistributed.
papers/*.pdf
