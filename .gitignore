/target
**/*.rs.bk
*.pdb

# Build artifacts. maturin's editable install drops the compiled extension into
# the source tree, where it is easy to commit by accident.
*.so
*.dylib
*.pyd

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Training artifacts
runs/
data/
*.safetensors
*.onnx
*.npz

# Benchmark output is regenerated, but keep committed results under bench/results/
bench/scratch/
